# FlyNoThink · PRODUZIONE · Apache (.htaccess). Richiede mod_headers e mod_rewrite.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-3hP6nchPpqPZYMRaarLlzlsqeIFG9CWac3iaX+5BCvQ='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://assets.mailerlite.com; form-action 'self' https://assets.mailerlite.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
  <FilesMatch "^(grazie|privacy|cookie|termini)\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://flynothink.it%{REQUEST_URI} [L,R=301]
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([a-z-]+)/?$ $1.html [L]
</IfModule>
AddType image/avif .avif
AddType font/woff2 .woff2
