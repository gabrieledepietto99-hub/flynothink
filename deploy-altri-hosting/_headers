# FlyNoThink · PRODUZIONE · intestazioni HTTP (Netlify, Cloudflare Pages). Copiare nella radice pubblicata.
# CSP in sola osservazione: passare a «Content-Security-Policy» dopo una settimana senza segnalazioni.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://*.iubenda.com https://www.googletagmanager.com https://*.clarity.ms 'sha256-c8psLLOUwXkyphqW0iwgZcKDA4HDmG4jpIXqSmgU+Hk='; style-src 'self' 'unsafe-inline' https://*.iubenda.com; img-src 'self' data: https://*.iubenda.com https://*.google-analytics.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com; font-src 'self'; connect-src 'self' https://assets.mailerlite.com https://*.iubenda.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com; form-action 'self' https://assets.mailerlite.com; frame-src https://*.iubenda.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self'

/grazie
  X-Robots-Tag: noindex, nofollow

/grazie.html
  X-Robots-Tag: noindex, nofollow

/privacy.html
  X-Robots-Tag: noindex, nofollow

/cookie.html
  X-Robots-Tag: noindex, nofollow

/termini.html
  X-Robots-Tag: noindex, nofollow

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=2592000
/assets/social/*
  Cache-Control: public, max-age=86400
/assets/css/*
  Cache-Control: public, max-age=3600
/assets/js/*
  Cache-Control: public, max-age=300
/*.html
  Cache-Control: no-cache
