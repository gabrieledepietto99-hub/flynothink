{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/check-publish.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://*.iubenda.com 'sha256-c8psLLOUwXkyphqW0iwgZcKDA4HDmG4jpIXqSmgU+Hk='; style-src 'self' 'unsafe-inline' https://*.iubenda.com; img-src 'self' data: https://*.iubenda.com; font-src 'self'; connect-src 'self' https://assets.mailerlite.com https://*.iubenda.com; form-action 'self' https://assets.mailerlite.com; frame-src https://*.iubenda.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/grazie",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/privacy",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/cookie",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/termini",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.flynothink.it"
        }
      ],
      "destination": "https://flynothink.it/:path*",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "https://www.iubenda.com/privacy-policy/66588632",
      "permanent": false
    },
    {
      "source": "/privacy.html",
      "destination": "https://www.iubenda.com/privacy-policy/66588632",
      "permanent": false
    },
    {
      "source": "/cookie",
      "destination": "https://www.iubenda.com/privacy-policy/66588632/cookie-policy",
      "permanent": false
    },
    {
      "source": "/cookie.html",
      "destination": "https://www.iubenda.com/privacy-policy/66588632/cookie-policy",
      "permanent": false
    }
  ]
}